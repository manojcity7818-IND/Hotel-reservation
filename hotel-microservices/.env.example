# Booking Service talks to Room Service and Payment Service over the Docker Compose network.
ROOM_SERVICE_URL=http://room-service:8000
PAYMENT_SERVICE_URL=http://payment-service:8000

# Host-machine ports (used only from your laptop/browser, not between containers)
# Hotel Service:    http://localhost:8000
# Room Service:     http://localhost:8002
# Booking Service:  http://localhost:8003
# Payment Service:  http://localhost:8004
# Website:          http://localhost:8080
